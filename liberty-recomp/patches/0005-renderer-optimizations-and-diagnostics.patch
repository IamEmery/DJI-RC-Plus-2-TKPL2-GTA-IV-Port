                           DirtyRangeSet& result, DirtyDeltaScratch& scratch) {
+  // Small layouts (every constant/stage layout) mark a stack bitset and read
+  // runs straight off it: elements come out sorted and unique without the
+  // vector, sort and unique below, which ran for every captured draw.
+  constexpr uint32_t kBitsetWords = 8;
+  if (layout.element_count <= kBitsetWords * 64) {
+    uint64_t marked[kBitsetWords] = {};
+    ForEachDirtyElement(dirty_words, layout,
+                        [&](uint32_t element) { marked[element >> 6] |= uint64_t{1} << (element & 63); });
+    result.ranges.clear();
+    const uint32_t words = (layout.element_count + 63) / 64;
+    uint32_t run_first = 0, run_count = 0;
+    for (uint32_t word = 0; word < words; ++word) {
+      uint64_t bits = marked[word];
+      if (!bits) {
+        if (run_count) result.ranges.push_back({run_first, run_count});
+        run_count = 0;
+        continue;
+      }
+      uint32_t bit = 0;
+      while (bit < 64) {
+        const uint64_t rest = bits >> bit;
+        if (!rest) {
+          if (run_count) result.ranges.push_back({run_first, run_count});
+          run_count = 0;
+          break;
+        }
+        const uint32_t zeros = uint32_t(std::countr_zero(rest));
+        if (zeros && run_count) {
+          result.ranges.push_back({run_first, run_count});
+          run_count = 0;
+        }
+        bit += zeros;
+        const uint32_t ones = uint32_t(std::countr_one(bits >> bit));
+        const uint32_t take = std::min<uint32_t>(ones, 64 - bit);
+        if (!run_count) run_first = word * 64 + bit;
+        run_count += take;
+        bit += take;
+      }
+    }
+    if (run_count) result.ranges.push_back({run_first, run_count});
+    return;
+  }
