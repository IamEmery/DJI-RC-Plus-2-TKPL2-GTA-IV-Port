+// A draw whose realized attachments are a subset of the active scope's (same
+// images, same extent and sample count) keeps that LOAD/STORE scope open: the
+// guest still has the other targets bound, only this draw's write mask skips
+// them. The pipeline is built from the borrowed attachment set with the draw's
+// own write mask (and its own depth/stencil tests, which are off when it had no
+// depth attachment), so untouched attachments keep their tile contents instead
+// of a store + load round trip per attachment-count change (TKPL2, Adreno 643:
+// the g-buffer split into a pass per draw this way).
+template <typename Target>
+bool BorrowNativeRenderingAttachments(const Target& active, Target& draw) {
+  if (active.samples != draw.samples || active.guest_samples != draw.guest_samples ||
+      active.width != draw.width || active.height != draw.height ||
+      active.logical_width != draw.logical_width || active.logical_height != draw.logical_height ||
+      active.uses_presenter || draw.uses_presenter || active.is_reflection || draw.is_reflection ||
+      active.temporal_shader != draw.temporal_shader ||
+      active.temporal_motion != draw.temporal_motion ||
+      active.temporal_reactive != draw.temporal_reactive ||
+      active.temporal_jitter != draw.temporal_jitter) {
+    return false;
+  }
+  if (draw.color_attachment_mask & ~active.color_attachment_mask) return false;
+  for (uint32_t index = 0; index < draw.color_views.size(); ++index) {
+    if ((draw.color_attachment_mask & (1u << index)) == 0) continue;
+    if (draw.color_views[index] != active.color_views[index] ||
+        draw.color_formats[index] != active.color_formats[index] ||
+        draw.color_surfaces[index] != active.color_surfaces[index]) {
+      return false;
+    }
+  }
+  if (draw.depth_stencil_attachment_active) {
+    if (!active.depth_stencil_attachment_active || draw.depth_view != active.depth_view ||
+        draw.depth_format != active.depth_format || draw.depth_surface != active.depth_surface) {
+      return false;
+    }
+  }
+  if (draw.color_attachment_mask == active.color_attachment_mask &&
+      draw.depth_stencil_attachment_active == active.depth_stencil_attachment_active) {
+    return false;  // Nothing to borrow: the normal equality path handles it.
+  }
+  draw.color_surfaces = active.color_surfaces;
+  draw.color_views = active.color_views;
+  draw.color_formats = active.color_formats;
+  draw.color_attachment_mask = active.color_attachment_mask;
+  draw.depth_surface = active.depth_surface;
+  draw.depth_view = active.depth_view;
+  draw.depth_format = active.depth_format;
+  draw.depth_stencil_attachment_active = active.depth_stencil_attachment_active;
+  return true;
+}
