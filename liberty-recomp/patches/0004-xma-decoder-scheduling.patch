+// Pins the calling thread to the cores whose cpuinfo_max_freq is the highest
+// (fastest_only) or above the slowest cluster's. Returns the core count or 0.
+int PinToFastCores(bool fastest_only, const char* who) {
+  long slowest = 0, fastest = 0;
+  std::vector<std::pair<int, long>> cores;
+  for (int cpu = 0; cpu < CPU_SETSIZE; ++cpu) {
+    char path[96];
+    std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", cpu);
+    FILE* file = std::fopen(path, "r");
+    if (!file) break;
+    long frequency = 0;
+    if (std::fscanf(file, "%ld", &frequency) != 1) frequency = 0;
+    std::fclose(file);
+    cores.emplace_back(cpu, frequency);
+    if (frequency && (!slowest || frequency < slowest)) slowest = frequency;
+    if (frequency > fastest) fastest = frequency;
+  }
+  cpu_set_t set;
+  CPU_ZERO(&set);
+  int count = 0;
+  for (const auto& [cpu, frequency] : cores) {
+    if (fastest_only ? frequency == fastest : frequency > slowest) {
+      CPU_SET(cpu, &set);
+      ++count;
+    }
+  }
+  if (!count || count == static_cast<int>(cores.size())) return 0;
+  const int result = sched_setaffinity(gettid(), sizeof(set), &set);
+  __android_log_print(ANDROID_LOG_WARN, "LibertyRecomp", "audio-affinity %s cores=%d result=%d",
+                      who, count, result);
+  return result ? 0 : count;
+}
